# Copia este archivo a `.env.local` y rellena los valores.
# Todo lo que empieza por NEXT_PUBLIC_ viaja al navegador: no pongas secretos ahí.

# Backend
NEXT_PUBLIC_API_URL=http://localhost:3000

# Teléfono de WhatsApp de la tienda, en formato venezolano (58 + 10 dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=584120000000

# Analítica (opcional)
NEXT_PUBLIC_GA_TRACKING_ID=

# Perfiles de redes sociales.
#
# Los iconos del pie y de "Mi cuenta" se pintan SÓLO si su variable trae una URL
# absoluta (http:// o https://). Sin configurar, el icono no aparece: antes los
# tres llevaban a las portadas genéricas de cada red y el cliente acababa en
# Facebook, no en la tienda. Deja en blanco lo que no exista.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=

# Zelle
NEXT_PUBLIC_ZELLE_ENABLED=false
NEXT_PUBLIC_ZELLE_EMAIL=
NEXT_PUBLIC_ZELLE_BENEFICIARY=

# PagoMóvil
NEXT_PUBLIC_PAGOMOVIL_ENABLED=false
NEXT_PUBLIC_PAGOMOVIL_BANK=
NEXT_PUBLIC_PAGOMOVIL_BANK_CODE=
NEXT_PUBLIC_PAGOMOVIL_PHONE=
NEXT_PUBLIC_PAGOMOVIL_CEDULA=

# Transferencia
NEXT_PUBLIC_TRANSFERENCIA_ENABLED=false
NEXT_PUBLIC_TRANSFERENCIA_BANK=
NEXT_PUBLIC_TRANSFERENCIA_BANK_CODE=
NEXT_PUBLIC_TRANSFERENCIA_ACCOUNT_NUMBER=
NEXT_PUBLIC_TRANSFERENCIA_RIF=
NEXT_PUBLIC_TRANSFERENCIA_BENEFICIARY=

# Sembrado del administrador (sólo servidor)
ADMIN_EMAIL=
ADMIN_PASSWORD=
